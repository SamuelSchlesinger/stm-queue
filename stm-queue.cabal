cabal-version:       2.4
name:                stm-queue
version:             0.2.2.0
synopsis:            Real-time concurrent queues with optional backpressure
description:         Real-time concurrent queues, including bounded queues
                     with transactional backpressure.
homepage:            https://github.com/SamuelSchlesinger/stm-queue
bug-reports:         https://github.com/SamuelSchlesinger/stm-queue/issues
license:             MIT
license-file:        LICENSE
author:              Samuel Schlesinger
maintainer:          sgschlesinger@gmail.com
copyright:           2020 Samuel Schlesinger
category:            Data
build-type:          Simple
extra-doc-files:     CHANGELOG.md
                     README.md
tested-with:         GHC ==9.6.7,
                     GHC ==9.8.4,
                     GHC ==9.10.3,
                     GHC ==9.12.4,
                     GHC ==9.14.1

source-repository head
  type: git
  location: https://github.com/samuelschlesinger/stm-queue

common warnings
  ghc-options:          -Wall
                        -Wcompat
                        -Widentities
                        -Wincomplete-uni-patterns
                        -Wincomplete-record-updates

library
  import:              warnings
  exposed-modules:     Data.Queue
  other-modules:       Data.Queue.Internal
  other-extensions:    LambdaCase, BangPatterns
  build-depends:       base >=4.12 && <5,
                       stm >=2.3 && <3
  hs-source-dirs:      src
  default-language:    Haskell2010

test-suite stm-queue-test
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test src
  other-modules:       Data.Queue.Internal
  main-is:             Test.hs
  build-depends:       base >=4.12 && <5,
                       stm >=2.3 && <3,
                       async >=2.2,
                       hspec >=2.7.4,
                       QuickCheck >=2.14
  other-extensions:    TypeApplications, BlockArguments, ScopedTypeVariables
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N -T" -O2
  default-language:    Haskell2010

benchmark stm-queue-benchmark
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      bench
  main-is:             Bench.hs
  build-depends:       base >=4.12 && <5,
                       stm >=2.4 && <3,
                       stm-queue,
                       async >=2.0,
                       criterion >=1.5
  other-extensions:    TypeApplications, BlockArguments, BangPatterns
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N -T" -O2
  default-language:    Haskell2010
